# ---- data source ----------------------------------------------------------
# Point at the sample SQLite DB (default) or the real NexToken Postgres.
# COPILOT_DATABASE_URL=sqlite:///./data/nextoken_sample.db
# COPILOT_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/nextoken

# ---- LLM runtime ----------------------------------------------------------
# sandbox (default, offline) | gateway | openai | anthropic | bedrock
COPILOT_LLM_MODE=sandbox
# Used when MODE != sandbox:
COPILOT_LLM_MODEL=nxt-gpt-4o-mini
COPILOT_LLM_BASE_URL=http://127.0.0.1:3100/v1
COPILOT_LLM_API_KEY=
COPILOT_LLM_TEMPERATURE=0

# ---- API auth -------------------------------------------------------------
# Must match the NexToken token issuer in production. Use >=32 bytes.
COPILOT_APP_SECRET=dev-secret-change-me-in-production-0123456789abcdef
# Allow X-Role / X-Customer-Id dev headers (disable in production!)
COPILOT_DEV_AUTH=1

# ---- tool source ------------------------------------------------------------
# local  = offline reference data layer via our MCP server
# remote = the live NexToken backend's audited /api/assistant/tools surface
COPILOT_TOOLS_MODE=local
COPILOT_BACKEND_URL=http://127.0.0.1:3100
# Backend JWT for remote mode (or pass per-request via Authorization header)
COPILOT_BACKEND_TOKEN=

# ---- guardrails -----------------------------------------------------------
COPILOT_MAX_ROWS=200

# ---- monitoring / feedback loop --------------------------------------------
# Append per-request JSONL traces (plan, routes, tools, latency). These traces
# are the training dataset for router fine-tuning (see OPTIMIZATION.md).
# COPILOT_TRACE_FILE=./data/traces.jsonl
